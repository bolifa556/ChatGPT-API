BASE_URL=https://gateway.example.com/v1
API_KEY=replace-with-your-gateway-key
SHIM_HOST=127.0.0.1
SHIM_PORT=8102
# Normal URL connections use existing OS routes, including campus VPN/TUN.
# Only ssh opts into the Windows launcher's optional SSH tunnel.
GATEWAY_TRANSPORT=direct
